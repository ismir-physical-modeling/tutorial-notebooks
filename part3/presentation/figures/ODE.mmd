     B2_inner:::coefficient
     P1_inner:::operation
     P2_inner:::operation
     M1_inner:::operation
     M2_inner:::operation
     M4_inner:::operation
     qn_minus_1:::variable
     qn:::variable
     xn:::variable
     qn_plus_1:::variable
    classDef coefficient fill:#e8f5e8,stroke:#5cb85c,stroke-width:1px
    classDef variable fill:transparent,stroke:transparent,stroke-width:0px
    classDef operation fill:#e6f3ff,stroke:#5bc0de,stroke-width:1px
    classDef nonlinear fill:#fff4e6,stroke:#ff9500,stroke-width:1px,rx:10,ry:10
    classDef subgraphStyle fill:#f5f5f5,stroke:#999,stroke-width:1px,rx:15,ry:15
