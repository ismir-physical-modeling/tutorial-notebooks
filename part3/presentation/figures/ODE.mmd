flowchart LR
 subgraph NonLinearBlock["Non-linearity"]
        B1_inner["$$\frac{2\Delta t^2}{2 + 2 \gamma \Delta t}$$"]
        F_inner("$$f_\theta(q_n)$$")
        M3_inner("$$\times$$")
  end


 subgraph ProcessingBlock[" "]
        A1_inner["$$\frac{2}{\Delta t^2} - \omega^2$$"]
        A2_inner["$$-\frac{1}{\Delta t^2} + \frac{2\gamma}{2\Delta t}$$"]
        B2_inner["$$\frac{2\Delta t^2}{2 + 2 \gamma \Delta t}$$"]
        P1_inner("$$+$$")
        P2_inner("$$+$$")
        M1_inner("$$\times$$")
        M2_inner("$$\times$$")
        M4_inner("$$\times$$")
        NonLinearBlock
        %% ModalProjection("$$\mathcal{T}$$")
  end
    qn_minus_1["$$q_{n-1}$$"] --> M1_inner
    qn["$$q_n$$"] --> M2_inner & F_inner
    xn["$$\bar{f}_\text{exc,n}$$"] --> M4_inner

    %% ModalProjection --> M4_inner
    F_inner --> M3_inner
    B1_inner --> M3_inner
    A1_inner --> M1_inner
    A2_inner --> M2_inner
    B2_inner --> M4_inner
    M2_inner --> P1_inner
